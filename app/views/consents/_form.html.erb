<%= form_with(model: consent) do |form| %>
  <% if consent.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(consent.errors.count, "error") %> prohibited this consent from being saved:</h2>

      <ul>
        <% consent.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :citizen_id, "Citizen" %>
    <%= form.collection_select :citizen_id, Citizen.order(:name), :id, :name, prompt: "Choose a citizen" %>
  </div>

  <div class="field">
    <%= form.label :service_id, "Service" %>
    <%= form.collection_select :service_id, Service.order(:name), :id, :name, prompt: "Choose a service" %>
  </div>

  <div class="field">
    <%= form.label :granted_at %>
    <%= form.datetime_field :granted_at %>
  </div>

  <div class="field">
    <%= form.label :revoked_at %>
    <%= form.datetime_field :revoked_at %>
  </div>

  <div class="field">
    <%= form.submit class: "btn" %>
  </div>
<% end %>

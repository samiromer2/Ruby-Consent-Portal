<p style="color: green"><%= notice %></p>

<% content_for :title, "Consents" %>

<h1>Consents</h1>

<div id="consents">
  <% @consents.each do |consent| %>
    <%= render consent %>
    <p>
      <%= link_to "Show this consent", consent %>
    </p>
  <% end %>
</div>

<%= link_to "New consent", new_consent_path %>

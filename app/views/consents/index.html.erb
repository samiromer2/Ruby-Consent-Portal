<% content_for :title, "Consents" %>

<div class="page-header">
  <h1>Consents</h1>
  <% if policy(Consent.new(citizen: Current.user.citizen)).create? %>
    <%= link_to "New consent", new_consent_path, class: "btn" %>
  <% end %>
</div>

<div id="consents" class="card-list">
  <% @consents.each do |consent| %>
    <div class="card">
      <%= render consent %>
      <%= link_to "View", consent, class: "card-link" %>
    </div>
  <% end %>
</div>

<% if @consents.empty? %>
  <p class="empty">No consents yet.</p>
<% end %>

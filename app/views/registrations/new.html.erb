<% content_for :title, "Sign up" %>

<h1>Sign up</h1>

<%= form_with model: @user, url: registration_path do |form| %>
  <% if @user.errors.any? || @user.citizen&.errors&.any? %>
    <div class="errors">
      <h2><%= pluralize(@user.errors.count + (@user.citizen&.errors&.count || 0), "error") %> prohibited this account from being saved:</h2>
      <ul>
        <% @user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
        <% @user.citizen&.errors&.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= label_tag :name %>
    <%= text_field_tag :name, params[:name], required: true, autofocus: true, autocomplete: "name" %>
  </div>

  <div class="field">
    <%= form.label :email_address, "Email address" %>
    <%= form.email_field :email_address, required: true, autocomplete: "username" %>
  </div>

  <div class="field">
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>

  <div class="field">
    <%= form.label :password_confirmation %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>

  <div class="field">
    <%= form.submit "Sign up" %>
  </div>
<% end %>

<p><%= link_to "Already have an account? Sign in", new_session_path %></p>

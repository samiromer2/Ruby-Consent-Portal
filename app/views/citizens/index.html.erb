<% content_for :title, "Citizens" %>

<div class="page-header">
  <h1>Citizens</h1>
</div>

<div id="citizens" class="card-list">
  <% @citizens.each do |citizen| %>
    <div class="card">
      <%= render citizen %>
      <%= link_to "View", citizen, class: "card-link" %>
    </div>
  <% end %>
</div>

<% if @citizens.empty? %>
  <p class="empty">No citizens yet.</p>
<% end %>

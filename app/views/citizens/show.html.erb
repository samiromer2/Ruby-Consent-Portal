<% content_for :title, "Citizen" %>

<h1>Citizen</h1>

<div class="card">
  <%= render @citizen %>
</div>

<div class="actions">
  <% if policy(@citizen).edit? %>
    <%= link_to "Edit", edit_citizen_path(@citizen), class: "btn" %>
  <% end %>
  <%= link_to "Back to citizens", citizens_path, class: "btn btn-secondary" %>
  <% if policy(@citizen).destroy? %>
    <%= button_to "Delete", @citizen, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Are you sure?" } %>
  <% end %>
</div>

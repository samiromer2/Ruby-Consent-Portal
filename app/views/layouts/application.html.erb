<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Consent Portal" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Consent Portal">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <nav class="container nav">
        <%= link_to "Consent Portal", root_path, class: "brand" %>
        <div class="nav-links">
          <% if authenticated? %>
            <%= link_to "Citizens", citizens_path, class: ("active" if controller_name == "citizens") %>
            <%= link_to "Services", services_path, class: ("active" if controller_name == "services") %>
            <%= link_to "Consents", consents_path, class: ("active" if controller_name == "consents") %>
          <% else %>
            <%= link_to "Sign in", new_session_path, class: ("active" if controller_name == "sessions") %>
            <%= link_to "Sign up", new_registration_path, class: ("active" if controller_name == "registrations") %>
          <% end %>
        </div>
        <% if authenticated? %>
          <div class="nav-session">
            <span><%= Current.user.email_address %></span>
            <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-nav" %>
          </div>
        <% end %>
      </nav>
    </header>

    <main class="container">
      <div id="flash">
        <% if notice.present? %>
          <div class="flash notice"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="flash alert"><%= alert %></div>
        <% end %>
      </div>

      <%= yield %>
    </main>
  </body>
</html>

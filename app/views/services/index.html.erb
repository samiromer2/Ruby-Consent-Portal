<% content_for :title, "Services" %>

<div class="page-header">
  <h1>Services</h1>
  <% if policy(Service).create? %>
    <%= link_to "New service", new_service_path, class: "btn" %>
  <% end %>
</div>

<div id="services" class="card-list">
  <% @services.each do |service| %>
    <div class="card">
      <%= render service %>
      <%= link_to "View", service, class: "card-link" %>
    </div>
  <% end %>
</div>

<% if @services.empty? %>
  <p class="empty">No services yet.</p>
<% end %>

<% content_for :title, "Service" %>

<h1>Service</h1>

<div class="card">
  <%= render @service %>
</div>

<div class="actions">
  <% if policy(@service).edit? %>
    <%= link_to "Edit", edit_service_path(@service), class: "btn" %>
  <% end %>
  <%= link_to "Back to services", services_path, class: "btn btn-secondary" %>
  <% if policy(@service).destroy? %>
    <%= button_to "Delete", @service, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Are you sure?" } %>
  <% end %>
</div>
